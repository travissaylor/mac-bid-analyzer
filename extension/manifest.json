{
  "manifest_version": 3,
  "name": "mac.bid Analyzer",
  "version": "0.1.0",
  "description": "Analyze mac.bid lots directly in your browser",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.mac.bid/*", "*://mac.bid/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html"
}
