#!/usr/bin/env bash
# Workflow helpers for git worktrees. Creation and removal are handled by
# another entity; this script just sets up isolation, lists, and validates
# that a worktree is safe to remove.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/wt <command> [args]

Commands:
  setup <path>     Apply isolation to an existing worktree at <path>:
                     - .env          symlinked to the main repo
                     - data.db       copied (isolated SQLite state)
                     - .claude/settings.local.json  copied
                     - .env.local    unique PORT (avoids :3000 collisions)
                     - node_modules  fresh `bun install`
                   Safe to re-run; only fills in what's missing.

  list | ls        Show every worktree git knows about, with its PORT.

  teardown <path>  Validate the worktree is safe to remove. Exits 0 if clean,
                   non-zero (with details on stderr) if uncommitted tracked
                   work exists. Does NOT delete anything — the caller is
                   expected to remove the worktree directory afterwards.
EOF
}

# Locate the main repo (directory that owns the shared .git dir).
git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" \
  || { echo "not inside a git repo" >&2; exit 1; }
[[ "$git_common_dir" = /* ]] || git_common_dir="$PWD/$git_common_dir"
git_common_dir="$(cd "$(dirname "$git_common_dir")" && pwd)/$(basename "$git_common_dir")"
MAIN_REPO="$(dirname "$git_common_dir")"

all_worktree_paths() {
  git -C "$MAIN_REPO" worktree list --porcelain \
    | awk '/^worktree / { print $2 }'
}

used_ports() {
  while IFS= read -r p; do
    [[ -f "$p/.env.local" ]] || continue
    awk -F= '/^PORT=/ { print $2 }' "$p/.env.local"
  done < <(all_worktree_paths)
}

next_port() {
  local used port=3001
  used="$(used_ports)"
  while grep -qx "$port" <<<"$used"; do port=$((port+1)); done
  printf '%s' "$port"
}

cmd_setup() {
  local dest="${1:-}"
  [[ -n "$dest" ]] || { usage; exit 1; }
  [[ -d "$dest" ]] || { echo "not a directory: $dest" >&2; exit 1; }
  dest="$(cd "$dest" && pwd)"
  [[ "$dest" == "$MAIN_REPO" ]] && { echo "refusing to setup the main repo at $dest" >&2; exit 1; }

  if [[ -f "$MAIN_REPO/.env" && ! -e "$dest/.env" ]]; then
    ln -s "$MAIN_REPO/.env" "$dest/.env"
  fi

  if [[ -f "$MAIN_REPO/data.db" && ! -e "$dest/data.db" ]]; then
    cp "$MAIN_REPO/data.db" "$dest/data.db"
  fi

  if [[ -f "$MAIN_REPO/.claude/settings.local.json" && ! -e "$dest/.claude/settings.local.json" ]]; then
    mkdir -p "$dest/.claude"
    cp "$MAIN_REPO/.claude/settings.local.json" "$dest/.claude/settings.local.json"
  fi

  local port
  if [[ -f "$dest/.env.local" ]] && grep -q '^PORT=' "$dest/.env.local"; then
    port="$(awk -F= '/^PORT=/ { print $2 }' "$dest/.env.local")"
  else
    port="$(next_port)"
    printf 'PORT=%s\n' "$port" >> "$dest/.env.local"
  fi

  ( cd "$dest" && bun install )

  echo
  echo "Worktree ready"
  echo "  path: $dest"
  echo "  PORT: $port"
}

cmd_list() {
  git -C "$MAIN_REPO" worktree list --porcelain | awk '
    /^worktree / { if (path != "") { printf "%s\t%s\n", branch, path } path=$2; branch="" }
    /^branch /   { branch=$2; sub("refs/heads/", "", branch) }
    /^detached/  { branch="(detached)" }
    END          { if (path != "") printf "%s\t%s\n", branch, path }
  ' | while IFS=$'\t' read -r branch path; do
    port=""
    [[ -f "$path/.env.local" ]] && port="$(awk -F= '/^PORT=/ { print $2 }' "$path/.env.local")"
    printf '%-32s  PORT=%-5s  %s\n' "$branch" "${port:-3000}" "$path"
  done
}

cmd_teardown() {
  local dest="${1:-}"
  [[ -n "$dest" ]] || { usage; exit 1; }
  [[ -d "$dest" ]] || { echo "not a directory: $dest" >&2; exit 1; }
  dest="$(cd "$dest" && pwd)"
  [[ "$dest" == "$MAIN_REPO" ]] && { echo "refusing to teardown the main repo" >&2; exit 1; }

  # Real work = anything not created by `setup`. Filter our isolation files out
  # of `git status` — they appear untracked in branches whose .gitignore predates
  # the update that ignores .env.local and .claude/settings.local.json.
  local leftover
  leftover="$(git -C "$dest" status --porcelain \
    | grep -v '^?? \.env$' \
    | grep -v '^?? \.env\.local$' \
    | grep -v '^?? data\.db$' \
    | grep -v '^?? \.claude/settings\.local\.json$' \
    || true)"

  if [[ -n "$leftover" ]]; then
    echo "worktree has uncommitted work:" >&2
    echo "$leftover" >&2
    exit 1
  fi

  local port=""
  [[ -f "$dest/.env.local" ]] && port="$(awk -F= '/^PORT=/ { print $2 }' "$dest/.env.local")"
  echo "Safe to remove: $dest${port:+ (PORT=$port)}"
}

case "${1:-}" in
  setup)             shift; cmd_setup "$@" ;;
  list|ls)           cmd_list ;;
  teardown)          shift; cmd_teardown "$@" ;;
  ""|-h|--help|help) usage ;;
  *)                 usage; exit 1 ;;
esac
